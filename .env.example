# This project is intentionally static-config first. Values are read once at process start.
APP_HOST=127.0.0.1
APP_PORT=18082
DEBUG_ENABLED=true
LOG_LEVEL=INFO
LLAMA_INDEX_LOG_LEVEL=DEBUG

API_FILE=api.txt
DEEPSEEK_BASE_URL=https://api.deepseek.com
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
RERANKER_MODEL_PATH=D:\text_Project\Agentic RAG\data\models\Qwen3-Reranker-0.6B

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=story_chunks
QDRANT_TIMEOUT_SECONDS=10
# Optional for a secured Qdrant server; never embed a key in QDRANT_URL.
QDRANT_API_KEY=

CHUNK_SIZE=512
CHUNK_OVERLAP=64
VECTOR_TOP_K=30
BM25_TOP_K=30
FUSION_TOP_K=30
RERANK_TOP_N=5
QUERY_FUSION_NUM_QUERIES=1
